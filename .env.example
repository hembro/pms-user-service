# ==============================================================================
# CORE APPLICATION
# ==============================================================================
APP_NAME=pms-user-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://user-service.test
APP_FRONTEND_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ==============================================================================
# SECURITY & CORS
# ==============================================================================
AUTH_GUARD=api
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=true

# ==============================================================================
# DATABASE (POSTGRESQL)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pms_user_service
DB_USERNAME=postgres
DB_PASSWORD=

# ==============================================================================
# REDIS & CACHING
# ==============================================================================
CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX="${APP_NAME}:"
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ==============================================================================
# QUEUE & MESSAGE BROKER (RabbitMQ)
# ==============================================================================
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

INTEGRATION_QUEUE_NAME=pms_user_service_queue

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE_NAME=microservices.topic
RABBITMQ_QUEUE=pms_user_service_integration_events

# ==============================================================================
# LOGGING & MISC (Filesystem, Mail, Session)
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SESSION_DRIVER=array
MAIL_MAILER=array
